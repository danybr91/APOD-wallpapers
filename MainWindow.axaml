<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="APOD_wallpapers.MainWindow"
        Title="APOD Wallpapers"
        MinWidth="800" MinHeight="600"
        Width="1024" Height="768"
        RequestedThemeVariant="Dark">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0067B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#106EBE"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>
        <Style Selector="HyperlinkButton.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="HyperlinkButton.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="HyperlinkButton.link:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Números del selector de fecha centrados y legibles -->
        <Style Selector="DatePicker /template/ TextBlock#PART_DayTextBlock,
                         DatePicker /template/ TextBlock#PART_MonthTextBlock,
                         DatePicker /template/ TextBlock#PART_YearTextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,2,8,0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="DatePicker /template/ TextBlock#PART_MonthTextBlock">
            <Setter Property="Margin" Value="0,2,8,0"/>
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="*, Auto, Auto">

        <!-- Imagen + overlay apilados -->
        <Grid Grid.Row="0">

            <Image Name="PreviewImage"
                   Stretch="Uniform"/>

            <!-- Overlay de carga -->
            <Border Name="LoadingOverlay"
                    Background="#CC1E1E1E"
                    IsVisible="True">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"
                                 Height="4"
                                 Foreground="#0078D4"
                                 Background="#444444"/>
                    <TextBlock Text="Descargando imagen..."
                               Foreground="#AAAAAA"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Navegación día anterior/siguiente -->
            <Button x:Name="PrevDayButton"
                    Click="PrevDayButton_Click"
                    ToolTip.Tip="Día anterior"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="12"
                    Width="44" Height="44"
                    Padding="0"
                    Opacity="0.85">
                <Path Fill="White"
                      Data="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"
                      Width="24" Height="24"/>
            </Button>
            <Button x:Name="NextDayButton"
                    Click="NextDayButton_Click"
                    ToolTip.Tip="Día siguiente"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="12"
                    Width="44" Height="44"
                    Padding="0"
                    Opacity="0.85">
                <Path Fill="White"
                      Data="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                      Width="24" Height="24"/>
            </Button>
        </Grid>

        <!-- Descripción de la imagen -->
        <ScrollViewer Grid.Row="1"
                      Background="#CC1E1E1E"
                      Height="200"
                      VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto, Auto, Auto">

                <!-- Fila 1: selector de fecha (izq), título (centrado), más información (der) -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="TitleText"
                               Padding="8"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="160,0,160, 0"/>
                    <DatePicker x:Name="DatePicker"
                                SelectedDateChanged="DatePicker_SelectedDateChanged"
                                MinWidth="138"
                                MaxWidth="138"
                                YearFormat="yyyy" 
                                MonthFormat="MM" 
                                DayFormat="dd" 
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="16,8,8,8"/>
                    <HyperlinkButton x:Name="MoreInfoLink"
                                     ToolTip.Tip="Más información"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Margin="8, 8, 24, 8"
                                     Padding="0">
                        <Path Fill="White"
                              Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                              Width="20" Height="20"/>
                    </HyperlinkButton>
                </Grid>

                <!-- Fila 2: descripción a todo el ancho -->
                <TextBlock x:Name="InfoText" Grid.Row="1"
                           Padding="16,8,16,8"
                           TextWrapping="Wrap"
                           UseLayoutRounding="False"/>

            </Grid>
        </ScrollViewer>
        
        <!-- Barra inferior -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="#44FFFFFF"
                Background="#2D2D2D"
                Padding="12,10">
            <Grid ColumnDefinitions="*, Auto">

                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text="Listo"
                           VerticalAlignment="Center"
                           Foreground="#AAAAAA"
                           FontSize="12"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <!-- Botón Descargar -->
                    <Button x:Name="DownloadButton" Click="DownloadButton_Click" IsEnabled="false">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Path Fill="White"
                                      Data="M8 2a.75.75 0 0 1 .75.75v6.69l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V2.75A.75.75 0 0 1 8 2ZM2 14.25a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z"
                                      Width="16" Height="16"/>
                            </Viewbox>
                            <TextBlock Text="Descargar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Botón Establecer fondo -->
                    <Button x:Name="SetWallpaperButton" Click="SetWallpaperButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" IsEnabled="false">
                                <Path Fill="White"
                                      Data="M2 4.5A2.5 2.5 0 0 1 4.5 2h7A2.5 2.5 0 0 1 14 4.5v7a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 11.5v-7Zm2.5-1a1 1 0 0 0-1 1v4.09l2.3-1.84a1 1 0 0 1 1.3.05l1.86 1.86 1.14-1.14a1 1 0 0 1 1.44.04L13 9.28V4.5a1 1 0 0 0-1-1h-7ZM13 11.5v-.53l-2.77-2.77-.96.96a1 1 0 0 1-1.44-.04L5.97 7.26 3.5 9.2V11.5a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1Zm-7.25-6a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Z"
                                      Width="16" Height="16"/>
                            </Viewbox>
                            <TextBlock Text="Establecer como fondo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>